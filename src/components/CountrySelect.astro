---
// Lista desplegable de países: bandera a la izquierda, nombre a la derecha,
// en orden alfabético según el idioma de la página, con buscador.
import { getCountryList } from '../lib/countries';
import { localeDefaultCountry, useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Prefijo único para los id, por si hay más de un selector en la página. */
  uid: string;
}

const { locale, uid } = Astro.props;
const t = useTranslations(locale);
const countries = getCountryList(locale);
---

<div class="dd" data-country-select data-default={localeDefaultCountry[locale]}>
  <span class="field-label" id={`${uid}-label`}>{t('form.country')}</span>
  <button
    type="button"
    class="control dd-button"
    id={`${uid}-button`}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${uid}-popover`}
    aria-labelledby={`${uid}-label ${uid}-button`}
    data-dd-button
  >
    <img class="dd-flag" data-cs-flag alt="" width="28" height="21" />
    <span class="dd-name" data-cs-name></span>
    <span class="dd-meta" data-cs-dial></span>
    <svg class="dd-chevron" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div class="dd-popover" id={`${uid}-popover`} data-dd-popover hidden>
    <input
      type="search"
      class="control dd-search"
      placeholder={t('form.searchCountry')}
      aria-label={t('form.searchCountry')}
      aria-controls={`${uid}-list`}
      autocomplete="off"
      spellcheck="false"
      data-dd-search
    />
    <ul class="dd-list" id={`${uid}-list`} role="listbox" aria-labelledby={`${uid}-label`} tabindex="-1" data-dd-list>
      {
        countries.map((country) => (
          <li
            role="option"
            id={`${uid}-option-${country.iso}`}
            aria-selected="false"
            data-iso={country.iso}
            data-dial={country.dial}
            data-name={country.name}
            data-flag={country.flag}
            data-search={country.search}
          >
            <img class="dd-flag" src={country.flag} alt="" width="28" height="21" loading="lazy" decoding="async" />
            <span class="dd-name">{country.name}</span>
            <span class="dd-meta">+{country.dial}</span>
          </li>
        ))
      }
    </ul>
    <p class="dd-empty" data-dd-empty hidden>{t('form.noResults')}</p>
  </div>
</div>

<script>
  import { setupDropdown } from '../lib/dropdown';

  document.querySelectorAll<HTMLElement>('[data-country-select]').forEach((root) => {
    const flag = root.querySelector<HTMLImageElement>('[data-cs-flag]')!;
    const name = root.querySelector<HTMLElement>('[data-cs-name]')!;
    const dial = root.querySelector<HTMLElement>('[data-cs-dial]')!;

    const dropdown = setupDropdown(root, (option, notify) => {
      flag.src = option.dataset.flag!;
      name.textContent = option.dataset.name!;
      dial.textContent = `+${option.dataset.dial}`;
      root.dataset.iso = option.dataset.iso;
      root.dataset.dial = option.dataset.dial;
      root.dispatchEvent(new CustomEvent('countrychange', { bubbles: true, detail: { user: notify } }));
    });

    // País inicial: el del idioma del navegador si se puede deducir; si no, el del idioma de la página.
    const byIso = (iso?: string) => dropdown.options.find((option) => option.dataset.iso === iso);
    const browserRegion = (navigator.languages ?? [navigator.language])
      .map((tag) => tag.split('-')[1]?.toUpperCase())
      .find((region) => region && byIso(region));
    dropdown.select(byIso(browserRegion) ?? byIso(root.dataset.default) ?? dropdown.options[0], false);
  });
</script>
