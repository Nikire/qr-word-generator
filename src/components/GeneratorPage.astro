---
// Página completa de una plantilla: título, generador, pasos, preguntas
// frecuentes y enlaces al resto de las plantillas.
import Base from '../layouts/Base.astro';
import Generator from './Generator.astro';
import NetworkBadge from './NetworkBadge.astro';
import AdSlot from './AdSlot.astro';
import { locales, useTranslations, type Locale, type UiKey } from '../i18n/ui';
import { DEFAULT_NETWORK, getContent, getNetwork, networkName, networkPath, sortedNetworks } from '../networks';
import { guidePath, guides, guidesIndexTitle } from '../guides';
import { SITE_URL } from '../../site.config.mjs';

interface Props {
  locale: Locale;
  networkId: string;
}

const { locale, networkId } = Astro.props;
const t = useTranslations(locale);
const network = getNetwork(networkId);
const name = networkName(network, locale);
const subtitle = network.subtitle[locale];

const heading = network.title?.[locale] ?? t('hero.title', { name });
const pageTitle = `${network.title?.[locale] ?? t('meta.title', { name })} | QR Word Generator`;
const description = `${subtitle} ${t('meta.descriptionTail')}`;

const paths = Object.fromEntries(locales.map((code) => [code, networkPath(code, network.id)])) as Record<Locale, string>;
const others = sortedNetworks(locale).filter((item) => item.id !== network.id);

const key = (value: string) => value as UiKey;
const steps = [1, 2, 3].map((n) => ({ title: t(key(`steps.${n}.title`)), text: t(key(`steps.${n}.text`)) }));
const content = getContent(network.id);
// Primero las preguntas propias de la plantilla; después las generales.
const faq = [
  ...[...(content?.faq ?? []), ...(network.faq ?? [])].map((item) => ({ q: item.q[locale], a: item.a[locale] })),
  ...[1, 2, 3].map((n) => ({ q: t(key(`faq.${n}.q`)), a: t(key(`faq.${n}.a`)) })),
];

const url = `${SITE_URL}${paths[locale]}`;
const home = `${SITE_URL}${networkPath(locale, DEFAULT_NETWORK)}`;
const isHome = network.id === DEFAULT_NETWORK;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: heading,
    url,
    description,
    inLanguage: locale,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'QR Word Generator', url: SITE_URL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  isHome
    ? { '@context': 'https://schema.org', '@type': 'WebSite', name: 'QR Word Generator', url: home, inLanguage: locale }
    : {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'QR Word Generator', item: home },
          { '@type': 'ListItem', position: 2, name, item: url },
        ],
      },
];
---

<Base locale={locale} title={pageTitle} description={description} paths={paths} jsonLd={jsonLd}>
  <section class="hero container">
    <h1>{heading}</h1>
    <p>{subtitle} {t('hero.tail')}</p>
  </section>

  <div class="container">
    <Generator locale={locale} network={network} />
  </div>

  <AdSlot position="top" label={t('ads.label')} />

  {
    content && (
      <section class="section container about">
        <h2>{content.heading[locale]}</h2>
        <p>{content.about[locale]}</p>
        <ul>
          {content.uses.map((use) => (
            <li>{use[locale]}</li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section container">
    <h2>{t('steps.title')}</h2>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li>
            <span class="step-number">{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container">
    <h2>{t('faq.title')}</h2>
    <div class="faq">
      {
        faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="section container">
        <h2>{t('templates.title')}</h2>
        <ul class="templates">
          {others.map((item) => (
            <li>
              <a href={networkPath(locale, item.id)}>
                <NetworkBadge id={item.id} />
                <span>{networkName(item, locale)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section container">
    <h2>{guidesIndexTitle[locale]}</h2>
    <ul class="guide-links">
      {
        guides.map((guide) => (
          <li>
            <a href={guidePath(locale, guide.id)}>{guide.title[locale]}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <AdSlot position="bottom" label={t('ads.label')} />
</Base>

<style>
  .hero {
    padding-top: 44px;
    padding-bottom: 28px;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.6rem);
    line-height: 1.15;
  }

  .hero p {
    max-width: 640px;
    margin: 12px auto 0;
    color: var(--muted);
    font-size: 1.05rem;
    text-wrap: pretty;
  }

  .section {
    margin-top: 56px;
  }

  .section h2 {
    margin-bottom: 20px;
    font-size: 1.45rem;
    text-align: center;
  }

  .about {
    max-width: 720px;
  }

  .about p,
  .about li {
    color: var(--muted);
    text-wrap: pretty;
  }

  .about ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 16px 0 0;
    padding-left: 22px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .step-number {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-bottom: 12px;
    background: var(--accent-soft);
    border-radius: 50%;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .steps h3 {
    margin-bottom: 4px;
    font-size: 1.02rem;
  }

  .steps p {
    color: var(--muted);
    font-size: 0.93rem;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 720px;
    margin: 0 auto;
  }

  .faq details {
    padding: 0 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .faq summary {
    padding: 14px 0;
    font-weight: 600;
    cursor: pointer;
  }

  .faq p {
    padding-bottom: 16px;
    color: var(--muted);
  }

  .templates {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .templates a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .templates a:hover {
    border-color: var(--accent);
  }

  .templates span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .guide-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 8px 24px;
    max-width: 900px;
    margin: 0 auto;
    padding-left: 22px;
  }

  .guide-links a {
    color: var(--accent-strong);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
