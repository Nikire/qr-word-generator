---
import CountrySelect from './CountrySelect.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  class="generator"
  data-generator
  data-msg-empty={t('preview.empty')}
  data-msg-invalid={t('preview.invalid')}
  data-msg-toolong={t('preview.tooLong')}
  data-copy={t('preview.copy')}
  data-copied={t('preview.copied')}
>
  <form class="form" novalidate data-form>
    <CountrySelect locale={locale} />

    <label class="field">
      <span class="field-label">{t('form.phone')}</span>
      <span class="phone">
        <span class="phone-prefix" data-prefix aria-hidden="true"></span>
        <input
          class="control"
          type="tel"
          inputmode="tel"
          autocomplete="tel-national"
          maxlength="24"
          placeholder={t('form.phonePlaceholder')}
          aria-describedby="phone-hint"
          data-phone
        />
      </span>
      <span class="field-hint" id="phone-hint">{t('form.phoneHint')}</span>
    </label>

    <label class="field">
      <span class="field-label">
        {t('form.message')}
        <small>({t('form.optional')})</small>
      </span>
      <textarea
        class="control"
        rows="3"
        maxlength="300"
        placeholder={t('form.messagePlaceholder')}
        aria-describedby="message-hint"
        data-message></textarea>
      <span class="field-hint" id="message-hint">{t('form.messageHint')}</span>
    </label>
  </form>

  <div class="result">
    <h2 class="result-title">{t('preview.title')}</h2>
    <div class="qr" data-qr role="img" aria-label={t('preview.title')}></div>
    <p class="status" data-status role="status" aria-live="polite"></p>

    <div class="link" data-link hidden>
      <span class="field-label">{t('preview.link')}</span>
      <div class="link-row">
        <a class="link-url" data-link-url target="_blank" rel="noopener noreferrer" title={t('preview.open')}></a>
        <button type="button" class="link-copy" data-copy-button>{t('preview.copy')}</button>
      </div>
    </div>

    <div class="downloads">
      <button type="button" class="btn btn-primary" data-download="png" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 20h16"></path>
        </svg>
        {t('download.png')}
      </button>
      <button type="button" class="btn btn-secondary" data-download="svg" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 20h16"></path>
        </svg>
        {t('download.svg')}
      </button>
    </div>
  </div>
</section>

<script>
  import { siWhatsapp } from 'simple-icons';
  import { buildQrSvg } from '../lib/qr';

  const PNG_SIZE = 1200;
  const logo = { path: siWhatsapp.path, color: `#${siWhatsapp.hex}` };

  const root = document.querySelector<HTMLElement>('[data-generator]')!;
  const country = root.querySelector<HTMLElement>('[data-country-select]')!;
  const prefix = root.querySelector<HTMLElement>('[data-prefix]')!;
  const phone = root.querySelector<HTMLInputElement>('[data-phone]')!;
  const message = root.querySelector<HTMLTextAreaElement>('[data-message]')!;
  const preview = root.querySelector<HTMLElement>('[data-qr]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const link = root.querySelector<HTMLElement>('[data-link]')!;
  const linkUrl = root.querySelector<HTMLAnchorElement>('[data-link-url]')!;
  const copyButton = root.querySelector<HTMLButtonElement>('[data-copy-button]')!;
  const downloads = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-download]'));

  let current: { svg: string; url: string; digits: string } | undefined;

  /** Número completo en formato internacional (solo dígitos), o cadena vacía si no hay número. */
  function fullNumber(): { digits: string; valid: boolean } {
    const dial = country.dataset.dial ?? '';
    const raw = phone.value.trim();
    let national = raw.replace(/\D/g, '');
    // Si pegaron el número completo con + o 00, se descarta el código de país repetido.
    if (/^(\+|00)/.test(raw)) {
      national = national.replace(/^00/, '');
      if (national.startsWith(dial)) national = national.slice(dial.length);
    }
    national = national.replace(/^0+/, '');
    if (!national) return { digits: '', valid: false };
    const digits = dial + national;
    return { digits, valid: national.length >= 5 && digits.length <= 15 };
  }

  function render() {
    prefix.textContent = `+${country.dataset.dial ?? ''}`;
    const { digits, valid } = fullNumber();
    const text = message.value.trim();
    let problem = '';
    current = undefined;

    if (!digits) problem = root.dataset.msgEmpty!;
    else if (!valid) problem = root.dataset.msgInvalid!;

    if (!problem) {
      const url = `https://wa.me/${digits}${text ? `?text=${encodeURIComponent(text)}` : ''}`;
      try {
        current = { svg: buildQrSvg({ data: url, logo }), url, digits };
      } catch {
        problem = root.dataset.msgToolong!;
      }
    }

    // Sin datos válidos se muestra un código de ejemplo atenuado.
    preview.innerHTML = current?.svg ?? buildQrSvg({ data: 'https://wa.me/', logo });
    preview.classList.toggle('is-placeholder', !current);
    status.textContent = problem;
    status.classList.toggle('is-error', Boolean(problem) && Boolean(digits));
    link.hidden = !current;
    if (current) {
      linkUrl.href = current.url;
      linkUrl.textContent = current.url;
    }
    for (const button of downloads) button.disabled = !current;
  }

  function save(blob: Blob, extension: string) {
    const anchor = document.createElement('a');
    anchor.href = URL.createObjectURL(blob);
    anchor.download = `qr-whatsapp-${current!.digits}.${extension}`;
    document.body.append(anchor);
    anchor.click();
    anchor.remove();
    setTimeout(() => URL.revokeObjectURL(anchor.href), 1000);
  }

  async function toPng(svg: string): Promise<Blob> {
    const image = new Image();
    image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;
    await image.decode();
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = PNG_SIZE;
    canvas.getContext('2d')!.drawImage(image, 0, 0, PNG_SIZE, PNG_SIZE);
    return new Promise((resolve, reject) =>
      canvas.toBlob((blob) => (blob ? resolve(blob) : reject(new Error('PNG'))), 'image/png'),
    );
  }

  for (const button of downloads) {
    button.addEventListener('click', async () => {
      if (!current) return;
      if (button.dataset.download === 'svg') {
        save(new Blob([current.svg], { type: 'image/svg+xml' }), 'svg');
      } else {
        save(await toPng(current.svg), 'png');
      }
    });
  }

  copyButton.addEventListener('click', async () => {
    if (!current) return;
    try {
      await navigator.clipboard.writeText(current.url);
      copyButton.textContent = root.dataset.copied!;
      setTimeout(() => (copyButton.textContent = root.dataset.copy!), 1800);
    } catch {
      // Portapapeles no disponible: el enlace sigue visible para copiarlo a mano.
    }
  });

  root.querySelector('form')!.addEventListener('submit', (event) => event.preventDefault());
  phone.addEventListener('input', render);
  message.addEventListener('input', render);
  country.addEventListener('countrychange', render);
  render();
</script>

<style>
  .generator {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    gap: 32px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .phone {
    display: flex;
    align-items: stretch;
  }

  .phone-prefix {
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-right: 0;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .phone .control {
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    background: var(--surface-2);
    border-radius: var(--radius-sm);
  }

  .result-title {
    font-size: 1.05rem;
  }

  .qr {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    aspect-ratio: 1;
    transition: opacity 0.2s ease;
  }

  .qr :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .qr.is-placeholder {
    opacity: 0.22;
    filter: grayscale(1);
  }

  .status {
    min-height: 1.4em;
    font-size: 0.88rem;
    color: var(--muted);
    text-align: center;
  }

  .status:empty {
    display: none;
  }

  .status.is-error {
    color: var(--danger);
  }

  .link-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 6px 6px 6px 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .link-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.85rem;
  }

  .link-copy {
    flex: none;
    min-height: 34px;
    padding: 4px 12px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }

  .link-copy:hover {
    border-color: var(--muted);
  }

  .downloads {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
  }

  .downloads .btn {
    padding-inline: 12px;
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .generator {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding: 18px;
    }
  }

  @media (max-width: 380px) {
    .downloads {
      grid-template-columns: 1fr;
    }
  }
</style>
