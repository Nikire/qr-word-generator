---
import Base from '../layouts/Base.astro';
import WhatsAppGenerator from './WhatsAppGenerator.astro';
import AdSlot from './AdSlot.astro';
import { useTranslations, type Locale, type UiKey } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const steps = [1, 2, 3] as const;
const key = (value: string) => value as UiKey;
---

<Base locale={locale} title={t('meta.title')} description={t('meta.description')}>
  <section class="hero container">
    <h1>{t('hero.title')}</h1>
    <p>{t('hero.subtitle')}</p>
  </section>

  <div class="container">
    <WhatsAppGenerator locale={locale} />
  </div>

  <AdSlot position="top" label={t('ads.label')} />

  <section class="section container">
    <h2>{t('steps.title')}</h2>
    <ol class="steps">
      {
        steps.map((n) => (
          <li>
            <span class="step-number">{n}</span>
            <h3>{t(key(`steps.${n}.title`))}</h3>
            <p>{t(key(`steps.${n}.text`))}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container">
    <h2>{t('faq.title')}</h2>
    <div class="faq">
      {
        steps.map((n) => (
          <details>
            <summary>{t(key(`faq.${n}.q`))}</summary>
            <p>{t(key(`faq.${n}.a`))}</p>
          </details>
        ))
      }
    </div>
  </section>

  <AdSlot position="bottom" label={t('ads.label')} />
</Base>

<style>
  .hero {
    padding-top: 44px;
    padding-bottom: 28px;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.6rem);
    line-height: 1.15;
  }

  .hero p {
    max-width: 620px;
    margin: 12px auto 0;
    color: var(--muted);
    font-size: 1.05rem;
    text-wrap: pretty;
  }

  .section {
    margin-top: 56px;
  }

  .section h2 {
    margin-bottom: 20px;
    font-size: 1.45rem;
    text-align: center;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .step-number {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-bottom: 12px;
    background: var(--accent-soft);
    border-radius: 50%;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .steps h3 {
    margin-bottom: 4px;
    font-size: 1.02rem;
  }

  .steps p {
    color: var(--muted);
    font-size: 0.93rem;
  }

  .faq {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 720px;
    margin: 0 auto;
  }

  .faq details {
    padding: 0 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .faq summary {
    padding: 14px 0;
    font-weight: 600;
    cursor: pointer;
  }

  .faq p {
    padding-bottom: 16px;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
