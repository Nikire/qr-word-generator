---
// Una página por plantilla y por idioma:
//   /            plantilla por defecto, español
//   /instagram/  otra plantilla, español
//   /en/         plantilla por defecto, inglés
//   /en/instagram/
// Más las páginas informativas de cada idioma (/privacidad/, /en/privacy/, …)
// y las guías (/guias/, /en/guides/, …).
import GeneratorPage from '../components/GeneratorPage.astro';
import InfoPage from '../components/InfoPage.astro';
import GuidePage from '../components/GuidePage.astro';
import { defaultLocale, locales, type Locale } from '../i18n/ui';
import { DEFAULT_NETWORK, networks } from '../networks';
import { infoIds, infoSegments, type InfoId } from '../info/pages';
import { guides, guideSegments } from '../guides';

export function getStaticPaths() {
  const generators = locales.flatMap((locale) =>
    networks.map((network) => {
      const parts = [
        locale === defaultLocale ? '' : locale,
        network.id === DEFAULT_NETWORK ? '' : network.id,
      ].filter(Boolean);
      return {
        params: { path: parts.join('/') || undefined },
        props: { locale, networkId: network.id },
      };
    }),
  );
  const infoPages = locales.flatMap((locale) =>
    infoIds.map((infoId) => ({
      params: { path: infoSegments(locale, infoId).join('/') },
      props: { locale, infoId },
    })),
  );
  // Índice de guías (/guias/) y una página por guía (/guias/<slug>/).
  const guidePages = locales.flatMap((locale) =>
    [undefined, ...guides.map((guide) => guide.id)].map((guideId) => ({
      params: { path: guideSegments(locale, guideId).join('/') },
      props: { locale, guideId, isGuide: true },
    })),
  );
  return [...generators, ...infoPages, ...guidePages];
}

interface Props {
  locale: Locale;
  networkId?: string;
  infoId?: InfoId;
  guideId?: string;
  isGuide?: boolean;
}

const { locale, networkId, infoId, guideId, isGuide } = Astro.props;
---

{isGuide ? <GuidePage locale={locale} guideId={guideId} /> : infoId ? <InfoPage locale={locale} infoId={infoId} /> : <GeneratorPage locale={locale} networkId={networkId!} />}
