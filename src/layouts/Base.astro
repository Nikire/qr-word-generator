---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { locales, localeNames, useTranslations, type Locale } from '../i18n/ui';
import { info, infoIds, infoPath } from '../info/pages';
import { guidePath, guidesLabel } from '../guides';
import { SITE_URL, BASE_PATH, ADSENSE_CLIENT } from '../../site.config.mjs';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta de esta misma página en cada idioma. */
  paths: Record<Locale, string>;
  /** Datos estructurados (schema.org) de la página. */
  jsonLd?: Record<string, unknown>[];
  /** Páginas que no deben aparecer en buscadores (p. ej. la de error 404). */
  noindex?: boolean;
}

const { locale, title, description, paths, jsonLd = [], noindex = false } = Astro.props;
const ogLocale = { es: 'es_419', en: 'en_US', pt: 'pt_BR', fr: 'fr_FR', it: 'it_IT' }[locale];
const t = useTranslations(locale);
const absolute = (path: string) => `${SITE_URL}${path}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#25D366" />
    <link rel="icon" type="image/svg+xml" href={`${BASE_PATH}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QR Word Generator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      SITE_URL && (
        <>
          <link rel="canonical" href={absolute(paths[locale])} />
          <meta property="og:url" content={absolute(paths[locale])} />
          <meta property="og:image" content={absolute(`${BASE_PATH}/og.png`)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:image" content={absolute(`${BASE_PATH}/og.png`)} />
          {locales.map((code) => (
            <link rel="alternate" hreflang={code} href={absolute(paths[code])} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(paths.es)} />
        </>
      )
    }
    {SITE_URL && jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <!-- Aplica el tema guardado antes de pintar la página, para evitar parpadeos. -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {
      ADSENSE_CLIENT && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <Header locale={locale} paths={paths} />
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <nav class="footer-links">
          <a href={guidePath(locale)}>{guidesLabel[locale]}</a>
          {infoIds.map((id) => <a href={infoPath(locale, id)}>{info[locale][id].title}</a>)}
        </nav>
        <nav class="footer-links footer-langs" aria-label={t('lang.label')}>
          {locales.map((code) => (
            <a href={paths[code]} hreflang={code} lang={code} aria-current={code === locale ? 'page' : undefined}>
              {localeNames[code]}
            </a>
          ))}
        </nav>
        <p>© {year} QR Word Generator. {t('footer.rights')}</p>
        <p>{t('footer.disclaimer')}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .footer {
    margin-top: 64px;
    padding: 28px 0 36px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 20px;
    margin-bottom: 14px;
  }

  .footer-links a {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
  }

  .footer-langs a {
    color: var(--muted);
    font-weight: 500;
  }

  .footer-langs a[aria-current] {
    color: var(--text);
  }

  .footer p + p {
    margin-top: 6px;
  }
</style>
