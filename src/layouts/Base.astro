---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { locales, localePath, useTranslations, type Locale } from '../i18n/ui';
import { SITE_URL, ADSENSE_CLIENT } from '../../site.config.mjs';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = useTranslations(locale);
const absolute = (path: string) => `${SITE_URL}${path}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#25D366" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="QR Word Generator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale} />
    {
      SITE_URL && (
        <>
          <link rel="canonical" href={absolute(localePath(locale))} />
          <meta property="og:url" content={absolute(localePath(locale))} />
          {locales.map((code) => (
            <link rel="alternate" hreflang={code} href={absolute(localePath(code))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute('/')} />
        </>
      )
    }
    <!-- Aplica el tema guardado antes de pintar la página, para evitar parpadeos. -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {
      ADSENSE_CLIENT && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <p>© {year} QR Word Generator. {t('footer.rights')}</p>
        <p>{t('footer.disclaimer')}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .footer {
    margin-top: 64px;
    padding: 28px 0 36px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer p + p {
    margin-top: 6px;
  }
</style>
